    "@docusaurus/theme-mermaid": "^3.3.2",
    "@easyops-cn/docusaurus-search-local": "^0.52.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.20.0"
  }
}
